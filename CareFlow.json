	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/users/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin.00@gmail.com\",\n  \"password\": \"adminadmin\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/users/login"
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"your_refresh_token\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/users/refresh"
					}
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Init Roles",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/init-roles"
					}
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"roleName\": \"patient\",\n  \"email\": \"patient@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/users"
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/user-profils/:id"
					}
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"active\",\n  \"firstName\": \"Updated Name\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/users/:userId"
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/users/:userId"
					}
				},
				{
					"name": "Filter Users by Role",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/users/filter/:roleName"
					}
				}
			]
		},
		{
			"name": "Rendezvous",
			"item": [
				{
					"name": "Create Rendezvous",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"medecinId\": \"6912fbc1f999ab3574d37b01\",\n  \"patientId\": \"patient_id_here\",\n  \"cause\": \"Consultation\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/rendezvous"
					}
				},
				{
					"name": "Get All Rendezvous",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/rendezvous"
					}
				},
				{
					"name": "Get Rendezvous by ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/rendezvous/:rendezId"
					}
				},
				{
					"name": "Update Rendezvous",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cause\": \"Updated cause\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/rendezvous/:rendezId"
					}
				},
				{
					"name": "Change Rendezvous Status",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/rendezvous/:rendezId/:status"
					}
				},
				{
					"name": "Delete Rendezvous",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/rendezvous/:rendezId"
					}
				},
