					"name": "Upload File to MinIO",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "file", "type": "file", "src": ""}
							]
						},
						"url": "{{baseUrl}}/files"
