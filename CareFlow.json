					"name": "Get Patient Documents",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/documents/patient/:patientId"
					}
				},
				{
					"name": "Delete Document",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/documents/:documentId"
					}
				}
			]
		},
