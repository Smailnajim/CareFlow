					"name": "Get Time Works",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/users/time-works"
					}
				}
			]
		},
		{
			"name": "Treatments",
			"item": [
				{
					"name": "Create Treatment",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Treatment description\",\n  \"vitalSigns\": {\n    \"bloodPressure\": \"120/80\",\n    \"heartRate\": 75,\n    \"temperature\": 37.5\n  }\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/tritments/rendesvous/:rendezId"
					}
				},
				{
					"name": "Get Treatment",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/tritments/:tritmentId"
					}
				},
				{
					"name": "Update Treatment",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Updated description\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/tritments/:tritmentId"
					}
				},
				{
					"name": "Delete Treatment",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/tritments/:tritmentId"
					}
				}
			]
		},
		{
			"name": "Prescriptions",
			"item": [
				{
					"name": "Create Prescription",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": \"patient_id\",\n  \"tritmentId\": \"treatment_id\",\n  \"medicaments\": [\n    {\n      \"name\": \"Paracetamol\",\n      \"dosage\": \"500mg\",\n      \"voieAdministration\": \"oral\",\n      \"frequence\": \"3 times daily\",\n      \"duree\": \"7 days\",\n      \"renouvellements\": 0\n    }\n  ]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/prescriptions"
					}
				},
				{
					"name": "Get Prescription",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/prescriptions/:id"
					}
				},
				{
					"name": "Get Doctor Prescriptions",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/doctor/prescriptions"
					}
				},
				{
					"name": "Get Patient Prescriptions",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/prescriptions/patient/:patientId"
					}
				},
				{
					"name": "Update Prescription Status",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"dispensed\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/prescriptions/:id/status"
					}
				},
				{
					"name": "Delete Prescription",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/prescriptions/:id"
					}
				},
				{
					"name": "Get Pharmacy Prescriptions",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/pharmacy/prescriptions"
					}
				},
				{
					"name": "Dispense Prescription",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/prescriptions/:id/dispense"
					}
				}
			]
		},
		{
			"name": "Lab Orders",
			"item": [
				{
					"name": "Create Lab Order",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": \"patient_id\",\n  \"tritmentId\": \"treatment_id\",\n  \"tests\": [\n    {\"name\": \"Blood Test\", \"type\": \"hematology\"},\n    {\"name\": \"Urine Test\", \"type\": \"urinalysis\"}\n  ]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/lab-orders"
					}
				},
				{
					"name": "Get Lab Order",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/lab-orders/:labOrderId"
					}
				},
				{
					"name": "Update Lab Order",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"completed\",\n  \"results\": [\n    {\n      \"testName\": \"Blood Test\",\n      \"value\": \"Normal\",\n      \"unit\": \"mg/dL\",\n      \"normalRange\": \"70-100\",\n      \"isAbnormal\": false\n    }\n  ],\n  \"pdfReport\": \"report_url.pdf\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "{{baseUrl}}/lab-orders/:labOrderId"
					}
				},
				{
					"name": "Get Patient Lab Orders",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/lab-orders/patient/:patientId"
					}
				},
				{
					"name": "Download Lab Report",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"url": "{{baseUrl}}/lab-orders/:labOrderId/download"
					}
				}
			]
		},
		{
			"name": "Documents",
			"item": [
				{
					"name": "Upload Document",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "file", "type": "file", "src": ""},
								{"key": "patientId", "value": "patient_id", "type": "text"},
								{"key": "tritmentId", "value": "treatment_id", "type": "text"},
								{"key": "category", "value": "imagerie", "type": "text"}
